---
import { Icon } from "astro-icon/components";
import GitHubHeatmap from "@/components/widgets/GitHubHeatmap.astro";
import MainCard from "@/components/MainCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Home">
  <MainCard
    title="Hi,I'm zro"
    description="A CS stident"
    textOverlay={"Hi,I'm zro.\nNice to meet you!"}
  >
    <section class="py-6">
      <div class="flex flex-col items-center text-center">
        <p class="text-lg text-base-content/80 max-w-2xl">
          这里是我的个人博客，记录技术、日常和分享。
        </p>
        <div class="flex flex-wrap gap-4 justify-center mt-6">
          <a href="/blog" class="btn btn-primary gap-2 btn-shine-effect">
            <Icon name="lucide:book-open" class="w-5 h-5" />
            <span>进入博客</span>
          </a>
        </div>
      </div>
    </section>

    <!-- GitHub Contributions -->
    <section class="py-4">
      <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
        <Icon name="lucide:github" class="w-6 h-6 text-primary" />
        <span>GitHub Contributions</span>
      </h2>
      <GitHubHeatmap username="zro070" />
    </section>
  </MainCard>
</BaseLayout>
