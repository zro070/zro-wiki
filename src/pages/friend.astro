---
import { Icon } from "astro-icon/components";
import MainCard from "@/components/MainCard.astro";
import FriendCard from "@/components/mdx/FriendCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Friends">
  <MainCard title="Friends">
    <!-- Friends Section -->
    <section>
      <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
        <Icon name="lucide:users" class="w-6 h-6 text-primary" />
        <span>Friends</span>
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        <FriendCard
          name="lvyneko"
          avatar="https://avatars.githubusercontent.com/u/175585268?v=4"
          description="code waves world"
          url="https://lvyovo-wiki.tech"
          type="friend"
        />
        <FriendCard
          name="Guoweiyi"
          avatar="https://avatars.githubusercontent.com/u/39240088?v=4"
          description="不知何时春日悄来临， 不知何日春花已落尽"
          url="https://gwy.fun/"
          type="friend"
        />
        <FriendCard
          name="BB"
          avatar="http://bbkitawink.org/wp-content/uploads/2026/05/pro_kita.png"
          description="Never bend your knees or lower your head"
          url="https://bbkitawink.org/"
          type="friend"
        />
      </div>

      <div class="flex justify-center mt-8">
        <a
          href="https://github.com/zro070/zro-wiki/edit/main/src/pages/friend.astro"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary gap-2"
        >
          <Icon name="lucide:plus-circle" class="w-5 h-5" />
          <span>申请友链</span>
        </a>
      </div>
    </section>
  </MainCard>
</BaseLayout>
