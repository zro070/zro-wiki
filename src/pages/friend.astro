---
import { Icon } from "astro-icon/components";
import MainCard from "@/components/MainCard.astro";
import FriendCard from "@/components/mdx/FriendCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Friends">
  <MainCard title="Friends">
    <!-- Friends Section -->
    <section>
      <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
        <Icon name="lucide:users" class="w-6 h-6 text-primary" />
        <span>Friends</span>
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        <FriendCard
          name="Lyme Blurred"
          avatar="https://github.com/lymeblurred.png"
          description="Building, breaking, and learning daily | A copy of EveSunMaple"
          url="https://github.com/lymeblurred"
          type="friend"
        />
        <FriendCard
          name="梦凌汐"
          avatar="https://github.com/MeowLynxSea.png"
          description="来自星辰边缘的猫猫~爱好是睡觉awa"
          url="https://github.com/MeowLynxSea"
          type="friend"
        />
        <FriendCard
          name="颜涂楷睿"
          avatar="https://github.com/SnowFoxqwq.png"
          description="你好，我是雪狐~"
          url="https://github.com/SnowFoxqwq"
          type="friend"
        />
      </div>

      <div class="flex justify-center mt-8">
        <a
          href="https://github.com/YOUR_USERNAME/YOUR_REPO/edit/main/src/pages/friend.astro"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary gap-2"
        >
          <Icon name="lucide:plus-circle" class="w-5 h-5" />
          <span>申请友链</span>
        </a>
      </div>
    </section>
  </MainCard>
</BaseLayout>
